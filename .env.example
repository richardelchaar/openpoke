# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs

# Optional: models (OpenRouter ids). OPENPOKE_MODEL sets every role;
# the per-role variables override it.
# OPENPOKE_MODEL=anthropic/claude-haiku-5.5
# OPENPOKE_INTERACTION_MODEL=
# OPENPOKE_EXECUTION_MODEL=
# OPENPOKE_SEARCH_MODEL=
# OPENPOKE_SUMMARIZER_MODEL=
# OPENPOKE_CLASSIFIER_MODEL=

# Optional: where the server stores its data (default: server/data)
# OPENPOKE_DATA_DIR=

# Optional: how the orchestrator finds an agent. The defaults are the version that did
# best in the evals. LOOKUP=none with PROMPT=v1 is the original behaviour.
# OPENPOKE_LOOKUP=records                 # none | records
# OPENPOKE_PROMPT=v2                      # v1 | v2
# OPENPOKE_DECIDER=orchestrator           # orchestrator | told_to_ask | code_rule | judge
# OPENPOKE_EXPLAIN_CANDIDATES=0           # 1 = tell the orchestrator how each candidate was found
